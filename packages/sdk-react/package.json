{
  "name": "@linea/react",
  "version": "0.1.0",
  "description": "React components and hooks for embedding Linea workflows and agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@linea/sdk": "workspace:*"
  },
  "devDependencies": {
    "@linea/eslint-config": "workspace:*",
    "@linea/typescript-config": "workspace:*",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18",
    "react-dom": "^18",
    "tsup": "^8",
    "typescript": "^5"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "linea",
    "ai",
    "workflow",
    "agent",
    "react",
    "sdk"
  ]
}
