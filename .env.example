# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Must have the pgvector extension installed.
DATABASE_URL=postgresql://linea:linea@localhost:5432/linea

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Dashboard: Webhooks → Add endpoint → copy signing secret
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex string. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# generate via openssl rand -base64 32
ENCRYPTION_KEY_1=hJl4hbfFimsQzPI3mzQXV+PnvupL9sPQeCrl1NWTc6c=

# ─── AI Model API Keys ───────────────────────────────────────────────────────
# At least one is required for agent nodes to work.
# Add keys only for the providers you want to use.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=AIza...

# Default model used when an agent node doesn't specify one.
# Must be an ID from apps/api/src/executions/engine/models/registry.ts
DEFAULT_AGENT_MODEL=claude-sonnet-4-6

# Cheap/fast model used by the execution supervisor (for retry/abort decisions).
# Defaults to claude-haiku-4-5 to keep costs low.
SUPERVISOR_MODEL=claude-haiku-4-5

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
