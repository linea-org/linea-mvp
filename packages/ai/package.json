{
  "name": "@linea/ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\""
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@linea/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.36.0",
    "@google/generative-ai": "^0.24.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@linea/eslint-config": "workspace:*",
    "@linea/types": "workspace:*",
    "@linea/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.9.3"
  }
}