{
  "name": "linea",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=!docs",
    "dev:api": "pnpm --filter=@linea/api dev",
    "dev:web": "pnpm --filter=@linea/web dev",
    "dev:docs": "pnpm --filter=@linea/docs dev",
    "dev:infra": "docker compose up postgres redis -d",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:push": "turbo db:push --filter=@linea/db",
    "db:generate": "turbo db:generate --filter=@linea/db",
    "db:migrate": "pnpm --filter=@linea/db db:migrate",
    "db:baseline": "pnpm --filter=@linea/db db:baseline",
    "db:studio": "turbo db:studio --filter=@linea/db",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@linea/eslint-config": "workspace:*",
    "@linea/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["pg", "@types/pg"]
    },
    "overrides": {
      "basic-ftp": ">=5.2.0",
      "handlebars": ">=4.7.9",
      "lodash": ">=4.18.1",
      "flatted": ">=3.4.0",
      "fast-uri": ">=3.1.2",
      "picomatch": ">=2.3.2",
      "langsmith": ">=0.5.19",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "postcss": ">=8.5.10",
      "hono": ">=4.12.16",
      "brace-expansion@1": "1.1.13",
      "uuid@>=11 <11.1.1": "11.1.1",
      "tmp": "0.2.4",
      "esbuild": ">=0.25.0",
      "ip-address": ">=9.0.5",
      "ajv": ">=6.12.6",
      "next@>=16.0.0 <16.2.6": "16.2.6",
      "next@>=15.0.0 <15.5.18": "15.5.18",
      "brace-expansion@2": "2.0.2"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
