# Public URL of the docs site (canonical URLs, sitemap, Open Graph). No trailing slash.
# NEXT_PUBLIC_BASE_URL=https://docs.getlinea.app

# GitHub token for roadmap page (optional; without it you get 60 req/hr limit)
# Create one at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Override repo if you fork
GITHUB_OWNER=linea-xyz
GITHUB_REPO=linea

# Password to access /docs/roadmap (required in production; roadmap is blocked without this)
ROADMAP_PASSWORD=
