{
  "extends": "@linea/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
     "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
