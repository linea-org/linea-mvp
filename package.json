{
  "name": "linea",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=!@linea/docs",
    "dev:api": "pnpm --filter=@linea/api dev",
    "dev:web": "pnpm --filter=@linea/web dev",
    "dev:docs": "pnpm --filter=@linea/docs dev",
    "dev:infra": "docker compose up postgres redis -d",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:push": "turbo db:push --filter=@linea/db",
    "db:generate": "turbo db:generate --filter=@linea/db",
    "db:migrate": "pnpm --filter=@linea/db db:migrate",
    "db:studio": "turbo db:studio --filter=@linea/db",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@linea/eslint-config": "workspace:*",
    "@linea/typescript-config": "workspace:*",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.10.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "langsmith@>=0.3.41 <0.4.6": ">=0.4.6",
      "langsmith@<=0.5.17": ">=0.5.18",
      "postcss@<8.5.10": ">=8.5.10",
      "langsmith@<=0.5.18": ">=0.5.19",
      "uuid@<11.1.1": ">=11.1.1",
      "langsmith@<0.6.0": ">=0.6.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "multer@>=1.0.0 <2.2.0": ">=2.2.0",
      "multer@>=2.0.0-alpha.1 <2.2.0": ">=2.2.0"
    }
  }
}